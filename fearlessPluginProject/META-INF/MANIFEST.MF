Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Fearless Eclipse Connect
Bundle-SymbolicName: fearlessPluginProject;singleton:=true
Bundle-Version: 2.3.0
Bundle-Vendor: Fearless
Bundle-Activator: fearlessPluginProject.Activator
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.swt,
 org.eclipse.ui,
 org.eclipse.ui.console,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.commands,
 org.eclipse.jdt.junit.core;bundle-version="3.14.200"
Automatic-Module-Name: fearlessPluginProject
Bundle-RequiredExecutionEnvironment: JavaSE-21
